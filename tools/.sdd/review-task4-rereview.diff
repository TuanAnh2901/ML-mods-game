+     """Atomically write UTF-8 text, creating the destination directory."""
+     temp = path.with_suffix(path.suffix + ".tmp")
+     temp.parent.mkdir(parents=True, exist_ok=True)
+     temp.write_text(content, encoding="utf-8")
