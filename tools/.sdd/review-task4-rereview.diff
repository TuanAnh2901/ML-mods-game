++def _process_is_live(pid: object) -> bool:
++    if not isinstance(pid, int) or pid <= 0:
++        return False
++    if sys.platform == "win32":
++        result = subprocess.run(
++            ["tasklist", "/FI", f"PID eq {pid}", "/FO", "CSV", "/NH"],
++            capture_output=True, text=True, check=False,
